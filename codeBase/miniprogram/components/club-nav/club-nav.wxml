<view class="root">
  <view class="fixed" style="padding-top: {{statusBarHeight}}px; background: {{bg}};">
    <view class="bar" style="height: {{navBarHeight}}px;">
      <view wx:if="{{showBack}}" class="side left" bindtap="onBack">‹</view>
      <view wx:else class="side left"></view>
      <view class="title-wrap">
        <text class="title" style="color: {{color}};">{{title}}</text>
      </view>
      <view class="side right" style="width: {{capsuleGap}}px;"></view>
    </view>
    <view
      wx:if="{{canSwitch}}"
      class="club-trigger"
      style="color: {{color}};"
      bindtap="onTitleTap"
    >
      <text class="club-label">{{currentLabel}}</text>
      <text class="chev">{{showMenu ? '▴' : '▾'}}</text>
    </view>
  </view>
  <view class="spacer" style="height: {{totalHeight}}px;"></view>

  <view class="menu-layer" wx:if="{{showMenu}}" catchtouchmove="noop">
    <view class="menu-mask" bindtap="closeMenu"></view>
    <view class="menu" style="top: {{totalHeight}}px;">
      <view
        wx:for="{{options}}"
        wx:key="id"
        class="menu-item {{value === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPick"
      >
        <text>{{item.shortName || item.name}}</text>
        <text wx:if="{{value === item.id}}" class="tick">✓</text>
      </view>
    </view>
  </view>
</view>
