.fixed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 500;
}

.bar {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.side {
  width: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.side.left {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
  padding-left: 8rpx;
}

.title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}

.club-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 44rpx;
  padding-bottom: 8rpx;
  opacity: 0.88;
}

.club-label {
  font-size: 22rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  font-size: 18rpx;
}

.menu-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 520;
}

.menu-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.28);
}

.menu {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(15, 61, 46, 0.18);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #1c2421;
  border-bottom: 1rpx solid #eef2f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.on {
  color: #0f3d2e;
  font-weight: 700;
  background: #f3f7f5;
}

.tick {
  color: #0f3d2e;
  font-size: 28rpx;
}
