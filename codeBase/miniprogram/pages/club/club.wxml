<view class="page">
  <club-nav show-back="{{true}}" bind:change="onFilterChange" />
  <view class="muted tip">入队请走活动分享链接报名。这里只维护已加入球队的分组；多队时点顶栏队名可切换。</view>

  <view wx:if="{{!clubs.length}}" class="card muted">
    球队信息还没同步。请让管理员把活动分享给你，打开链接报名后会自动加入。
  </view>

  <view wx:for="{{clubs}}" wx:key="_id" class="card">
    <view class="title-row">
      <view class="title">{{item.name}}</view>
      <view class="badge" wx:if="{{item.joined}}">已加入</view>
    </view>
    <view class="muted" wx:if="{{item._id === 'club_jielong'}}">界龙不用选常驻组。报名后由老板当场分队。</view>
    <view class="muted" wx:else>可改默认报名分组。只影响之后新报名的场次。</view>

    <block wx:if="{{item._id === 'club_jielong'}}">
      <view wx:if="{{item.joined}}" class="joined">你已加入，可以直接去活动页报名。</view>
      <view wx:else class="muted">尚未加入。请打开分享来的界龙活动链接报名。</view>
    </block>

    <block wx:else>
      <view wx:if="{{!item.joined}}" class="muted">尚未加入。请打开分享来的周三联活动链接报名。</view>
      <block wx:if="{{item.joined}}">
        <view wx:for="{{item.groups}}" wx:for-item="group" wx:for-index="gIndex" wx:key="id" class="group-block">
          <view class="group">
            <view class="dot" style="background: {{group.color}};" data-club="{{item._id}}" data-id="{{group.id}}" bindtap="onPick"></view>
            <input
              wx:if="{{item.role === 'owner'}}"
              class="input"
              value="{{group.name}}"
              data-club="{{item._id}}"
              data-index="{{gIndex}}"
              bindinput="onName"
              bindblur="saveName"
            />
            <view
              wx:else
              class="group-name {{item.groupId === group.id ? 'on' : ''}}"
              data-club="{{item._id}}"
              data-id="{{group.id}}"
              bindtap="onPick"
            >{{group.name}}{{item.groupId === group.id ? ' · 我的组' : ''}}</view>
            <view wx:if="{{item.role === 'owner'}}" class="order">
              <text data-club="{{item._id}}" data-index="{{gIndex}}" data-dir="{{-1}}" bindtap="move">上</text>
              <text data-club="{{item._id}}" data-index="{{gIndex}}" data-dir="{{1}}" bindtap="move">下</text>
            </view>
          </view>
          <view class="colors" wx:if="{{item.role === 'owner'}}">
            <view
              wx:for="{{colors}}"
              wx:for-item="swatch"
              wx:key="label"
              class="dot"
              style="background: {{swatch.color}};"
              data-club="{{item._id}}"
              data-group="{{group.id}}"
              data-color="{{swatch.color}}"
              data-label="{{swatch.label}}"
              bindtap="onColor"
            ></view>
          </view>
        </view>
      </block>
    </block>
  </view>
  <nav current="me" />
</view>
