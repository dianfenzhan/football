.tip { margin-bottom: 16rpx; }
.title-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.badge {
  background: #e8efe9;
  color: #0f3d2e;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.group { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.dot { width: 28rpx; height: 28rpx; border-radius: 50%; border: 1rpx solid #ddd; }
.group-name { flex: 1; }
.group-name.on { color: #0f3d2e; font-weight: 600; }
.input { flex: 1; background: #f4f6f5; border-radius: 8rpx; padding: 8rpx 12rpx; }
.order { display: flex; gap: 16rpx; color: #0f3d2e; }
.colors { display: flex; gap: 12rpx; margin: 8rpx 0 8rpx 40rpx; }
.joined { margin-top: 16rpx; color: #0f3d2e; font-weight: 600; }
.btn {
  background: #0f3d2e;
  color: #fff;
  border-radius: 12rpx;
  margin-top: 20rpx;
}
.invite-btn {
  margin-top: 16rpx;
  font-size: 28rpx;
}
.btn.ghost {
  background: #fff;
  color: #0f3d2e;
  border: 1rpx solid #0f3d2e;
}
.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(28, 36, 33, 0.45);
}
.share-sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
}
.share-sheet .title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.share-sheet .btn {
  display: block;
  width: 100%;
  margin: 24rpx 0 0;
}
.reg-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0;
}
.avatar-chooser {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #e7eeeb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.avatar-plus {
  font-size: 48rpx;
  color: #66706c;
  line-height: 1;
}
.reg-input {
  margin-top: 8rpx;
  margin-bottom: 12rpx;
}
.reg-positions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
.reg-pos {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: #f2f5f3;
  color: #33443d;
  font-size: 24rpx;
}
.reg-pos.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}
.roster-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f3d2e;
}
.roster-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.roster-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f2f5f3;
  font-size: 24rpx;
  color: #33443d;
}
.roster-chip.on {
  background: #0f3d2e;
  color: #fff;
}
.roster-chip .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.muted { color: #66706c; font-size: 24rpx; }
