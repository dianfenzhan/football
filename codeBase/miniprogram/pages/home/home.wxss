.screen {
  min-height: 100vh;
  padding: 32rpx 24rpx 160rpx;
  box-sizing: border-box;
  background: #e8efe9;
}

.loading,
.empty {
  color: #66706c;
  font-size: 26rpx;
  padding: 12rpx 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.brand-ball {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 61, 46, 0.12);
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f3d2e;
}

.brand-sub {
  color: #66706c;
  font-size: 24rpx;
}

.next-block {
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(15, 61, 46, 0.18);
  margin-bottom: 8rpx;
}

.hero {
  background: linear-gradient(165deg, #123f30 0%, #1f6a4f 58%, #2a7d5c 100%);
  color: #fff;
  border-radius: 0;
  padding: 36rpx 32rpx 28rpx;
  margin-bottom: 0;
  box-shadow: none;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.countdown {
  background: rgba(242, 193, 78, 0.2);
  color: #f5cb6a;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #b7d7c8;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #e4f3eb;
}

.quota {
  margin-top: 24rpx;
}

.quota-head {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #d7e6df;
}

.bar {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #f2c14e;
}

.next-mid {
  background: #dceee4;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid rgba(15, 61, 46, 0.06);
}

.signed-banner {
  background: rgba(255, 255, 255, 0.72);
  color: #0f3d2e;
  font-weight: 600;
  text-align: center;
  border-radius: 14rpx;
  line-height: 2.6;
  font-size: 30rpx;
}

.other-hint {
  margin-top: 16rpx;
  padding: 16rpx 8rpx 4rpx;
  color: #3d6b58;
  font-size: 26rpx;
  text-align: center;
}

.other-hint.lone {
  margin: 0 0 20rpx;
  padding: 20rpx;
  background: #edf5f0;
  border-radius: 16rpx;
}

.btn.hero-cta {
  width: 100%;
  margin: 0;
  line-height: 2.6;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 14rpx;
  background: #0f3d2e;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(15, 61, 46, 0.22);
}

.next-weather {
  background: #edf5f0;
  border-top: 1rpx solid rgba(15, 61, 46, 0.06);
}

.hero-empty {
  background: linear-gradient(165deg, #123f30 0%, #1f6a4f 100%);
  color: #fff;
  border-radius: 28rpx;
  text-align: center;
  padding: 72rpx 32rpx 56rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 61, 46, 0.18);
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b7d7c8;
}
