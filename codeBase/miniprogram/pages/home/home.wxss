.screen {
  min-height: 100vh;
  padding: 32rpx 24rpx 160rpx;
  box-sizing: border-box;
  background: #e7eeeb;
}

.loading,
.empty {
  color: #66706c;
  font-size: 26rpx;
  padding: 12rpx 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.brand-ball {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 61, 46, 0.12);
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f3d2e;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #66706c;
}

.hero {
  background: linear-gradient(160deg, #0f3d2e 0%, #1d6b50 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 61, 46, 0.25);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.countdown {
  background: rgba(242, 193, 78, 0.18);
  color: #f2c14e;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #b7d7c8;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #e4f3eb;
}

.quota {
  margin-top: 24rpx;
}

.quota-head {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #d7e6df;
}

.bar {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #f2c14e;
}

.hero-empty {
  text-align: center;
  padding: 72rpx 32rpx 56rpx;
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b7d7c8;
}

.signed-banner {
  background: #e3efe9;
  color: #0f3d2e;
  font-weight: 600;
  text-align: center;
  border-radius: 16rpx;
  line-height: 2.8;
  font-size: 32rpx;
}

.btn.hero {
  width: 100%;
  margin: 0;
  line-height: 2.8;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 61, 46, 0.3);
}
