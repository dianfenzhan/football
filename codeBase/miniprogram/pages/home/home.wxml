<view class="screen">
  <view class="brand">
    <view class="brand-ball">⚽️</view>
    <view class="brand-text">
      <view class="brand-name">快乐足球</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中</view>
  <block wx:else>
    <view wx:if="{{noClub}}" class="hero hero-empty">
      <view class="empty-icon">⚽️</view>
      <view class="empty-title">还没有加入球队</view>
      <view class="empty-sub">请让管理员把活动分享给你，打开链接报名后会自动加入</view>
    </view>
    <block wx:elif="{{next}}">
      <view class="next-block">
        <view class="hero" data-id="{{next._id}}" data-club="{{next.clubId}}" bindtap="open">
          <view class="hero-top">
            <view class="kicker">下一场{{next.clubLabel ? ' · ' + next.clubLabel : ''}}</view>
            <view class="countdown">{{next.countdown}}</view>
          </view>
          <view class="hero-title">{{next.title}}</view>
          <view class="hero-meta">📅 {{next.dateText}} {{next.clock}}</view>
          <view class="hero-meta">📍 {{next.location}}</view>
          <view wx:if="{{next.isPool}}" class="quota">
            <view class="quota-head">
              <text>已报名</text>
              <text>{{next.poolSigned}} / {{next.poolCap}}</text>
            </view>
            <view class="bar"><view class="bar-fill" style="width: {{next.poolPercent}}%;"></view></view>
          </view>
          <view wx:for="{{next.quotas}}" wx:key="teamId" class="quota">
            <view class="quota-head">
              <text>{{item.teamName}}</text>
              <text>{{item.signed}} / {{item.maxSignups}}</text>
            </view>
            <view class="bar"><view class="bar-fill" style="width: {{item.percent}}%;"></view></view>
          </view>
        </view>
        <view class="next-mid">
          <view wx:if="{{next.signedUp}}" class="signed-banner">✓ 已报名 · {{signedTeamName}}</view>
          <button wx:else class="btn hero-cta" data-id="{{next._id}}" data-club="{{next.clubId}}" bindtap="open">⚽️ 去报名</button>
        </view>
        <view wx:if="{{otherHint}}" class="other-hint" bindtap="openOther">{{otherHint}} ›</view>
        <view wx:if="{{weather}}" class="next-weather" catchtap="noop">
          <weather-hour
            hours="{{weather.hours}}"
            sunrise="{{weather.sunrise}}"
            sunset="{{weather.sunset}}"
            default-index="{{weather.defaultIndex}}"
            venue-address="{{weather.venueAddress}}"
            date-label="{{next.weatherDateText}}"
            embedded="{{true}}"
          />
        </view>
      </view>
    </block>
    <view wx:else class="hero hero-empty">
      <view class="empty-icon">🥅</view>
      <view class="empty-title">最近没有球局</view>
      <view class="empty-sub">等管理员安排一场，先看看别的</view>
    </view>
    <view wx:if="{{otherHint && !next}}" class="other-hint lone" bindtap="openOther">{{otherHint}} ›</view>
    <button wx:if="{{isAdmin && !next && !noClub}}" class="btn hero-cta" bindtap="create">＋ 新建活动</button>
  </block>
  <nav current="home" />
  <mirror />
</view>
