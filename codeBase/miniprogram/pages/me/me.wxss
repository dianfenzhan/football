.reg-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0;
}

.avatar-chooser {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #e7eeeb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.chooser-fallback {
  width: 96rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.reg-teams {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.reg-team {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #3d4944;
}

.reg-team.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.grant-hint {
  margin: 12rpx 0 8rpx;
}

.member {
  padding: 16rpx 0;
  border-top: 1rpx solid #e3e8e6;
}
