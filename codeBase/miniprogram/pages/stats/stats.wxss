.segment {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
}

.segment-item {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  text-align: center;
  color: #66706c;
  font-size: 24rpx;
  line-height: 1.3;
}

.segment-item.on {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.board {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx 8rpx;
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  margin: 0 -8rpx 8rpx;
  border-bottom: 1rpx solid #eef2f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0 18rpx;
  color: #66706c;
  font-size: 28rpx;
  position: relative;
}

.tab.on {
  color: #0f3d2e;
  font-weight: 700;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 28%;
  right: 28%;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: #0f3d2e;
}

.board-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-top: 16rpx;
}

.board-title {
  font-size: 30rpx;
  font-weight: 700;
}

.board-note {
  color: #8a9691;
  font-size: 22rpx;
}

.empty {
  color: #66706c;
  font-size: 26rpx;
  padding: 28rpx 0 36rpx;
}

.rank {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eef2f0;
}

.badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #e7eeeb;
  color: #3d4944;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.badge-1 {
  background: #f2c14e;
  color: #3d3208;
}

.badge-2 {
  background: #d5ddd8;
  color: #24302b;
}

.badge-3 {
  background: #e7c3a2;
  color: #4a2e18;
}

.who {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team {
  color: #66706c;
  font-size: 22rpx;
}

.value {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f3d2e;
  line-height: 1;
}

.value-miss {
  color: #8c3a2f;
}
