@import "../../app.wxss";

.pills {
  display: flex;
  gap: 16rpx;
}

.pill {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #f4f6f5;
  color: #3d4944;
  font-size: 26rpx;
}

.pill.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.admin-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.player-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.player-name {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-tag {
  font-size: 20rpx;
  color: #0f3d2e;
  background: #e3efe9;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.player-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.pos-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #0f3d2e;
  background: #f4f6f5;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.edit-hint {
  font-size: 22rpx;
  color: #66706c;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(0, 0, 0, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.modal-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.edit-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0;
}

.avatar-chooser {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #e7eeeb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.chooser-fallback {
  width: 96rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.reg-positions {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.reg-pos {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #3d4944;
  font-size: 26rpx;
}

.reg-pos.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
}
