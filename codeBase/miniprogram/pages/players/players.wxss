@import "../../app.wxss";

.pills {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.pill {
  min-width: 0;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f6f5;
  color: #3d4944;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.admin-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.player-name {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.player-stats-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.ps-pill {
  font-size: 20rpx;
  color: #3d4944;
  background: #f4f6f5;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.modal-stats-block {
  margin-bottom: 20rpx;
}

.modal-stats-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 8rpx;
}

.modal-stat-item {
  background: #f4f6f5;
  border-radius: 12rpx;
  padding: 14rpx 4rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-width: 0;
}

.modal-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f3d2e;
  line-height: 1.2;
}

.modal-stat-label {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #6a7771;
  white-space: nowrap;
}

.grant-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.admin-tag {
  font-size: 20rpx;
  color: #0f3d2e;
  background: #e3efe9;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.player-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.admin-switch {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-width: 96rpx;
}

.admin-switch-label {
  font-size: 20rpx;
  color: #0f3d2e;
  font-weight: 600;
  line-height: 1.2;
}

.grant-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.pos-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #0f3d2e;
  background: #f4f6f5;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.edit-hint {
  font-size: 22rpx;
  color: #66706c;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(0, 0, 0, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.modal-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.edit-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0;
}

.avatar-chooser {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #e7eeeb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.chooser-fallback {
  width: 96rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.reg-positions {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.reg-pos {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #3d4944;
  font-size: 26rpx;
}

.reg-pos.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
}
