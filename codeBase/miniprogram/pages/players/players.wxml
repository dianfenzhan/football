<view class="page">
  <club-nav bind:change="onFilterChange" />

  <view class="card">
    <view class="pills" wx:if="{{groupFilters.length}}">
      <view
        wx:for="{{groupFilters}}"
        wx:key="id"
        class="pill {{groupId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onGroup"
      >{{item.name}}</view>
    </view>
    <view class="muted admin-tip" wx:elif="{{canEditPlayers}}">管理员可点击队员修改昵称、头像和擅长位置。</view>
    <view class="muted admin-tip" wx:else>当前筛选：{{clubFilterLabel}}</view>
  </view>

  <view class="card" wx:if="{{!loading && players.length === 0}}">
    <view class="muted">还没有队员</view>
  </view>

  <view
    class="card player-row"
    wx:for="{{players}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="onTapPlayer"
  >
    <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
    <view wx:else class="avatar-fallback" style="background: {{item.avatarBg}};">{{item.avatarChar}}</view>
    <view class="player-info">
      <view class="name-line">
        <text class="player-name">{{item.name}}</text>
        <text wx:if="{{item.isCaptain}}" class="admin-tag">队长</text>
        <text wx:elif="{{item.clubAdminTag}}" class="admin-tag">{{item.clubAdminTag}}</text>
      </view>
      <view class="muted sub" wx:if="{{item.metaText}}">{{item.metaText}}</view>
    </view>
    <view class="player-right" catchtap="noop">
      <text class="pos-badge">{{item.positionLabel}}</text>
      <view wx:if="{{canGrantThisClub && item.canToggleAdmin}}" class="admin-switch">
        <text class="admin-switch-label">管理员</text>
        <switch
          checked="{{item.isClubAdmin}}"
          disabled="{{grantingId === item._id}}"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
          data-on="{{item.isClubAdmin}}"
          bindchange="onGrant"
          color="#0f3d2e"
        />
      </view>
      <text wx:elif="{{canEditPlayers}}" class="edit-hint">编辑 ›</text>
    </view>
  </view>

  <view wx:if="{{showEditModal}}" class="modal-mask" catchtouchmove="noop">
    <view class="modal-card">
      <view class="title">修改队员资料</view>
      <view class="edit-avatar-row">
        <button class="avatar-chooser" open-type="chooseAvatar" bind:chooseavatar="onChooseEditAvatar">
          <image wx:if="{{editAvatarPreview}}" class="avatar-img" src="{{editAvatarPreview}}" mode="aspectFill"/>
          <view wx:else class="avatar-fallback chooser-fallback" style="background: {{editAvatarBg}};">{{editAvatarChar}}</view>
        </button>
        <view class="muted">点击更换头像</view>
      </view>
      <view class="field">
        <text class="label">昵称</text>
        <input class="input" value="{{editName}}" bindinput="onEditName" placeholder="队员昵称" />
      </view>
      <view class="field">
        <text class="label">擅长位置</text>
        <view class="reg-positions">
          <view
            wx:for="{{positions}}"
            wx:key="id"
            class="reg-pos {{editPosition === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onEditPosition"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="field grant-row" wx:if="{{canGrantThisClub && editCanToggleAdmin}}">
        <view>
          <text class="label">本队管理员</text>
          <view class="muted grant-hint">打开后可建活动、记分；只对本队有效</view>
        </view>
        <switch checked="{{editIsClubAdmin}}" bindchange="onEditGrant" color="#0f3d2e" />
      </view>
      <view class="modal-actions">
        <button class="btn ghost modal-btn" disabled="{{savingPlayer}}" bindtap="closeEditModal">取消</button>
        <button class="btn modal-btn" loading="{{savingPlayer}}" disabled="{{savingPlayer}}" bindtap="saveEditPlayer">保存</button>
      </view>
    </view>
  </view>

  <nav current="players" />
  <mirror />
</view>
