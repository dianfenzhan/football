<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">报名方式（创建后不能改）</text>
      <view class="mode-row">
        <view
          class="mode-card {{signupMode === 'split' ? 'active' : ''}}"
          data-mode="split"
          bindtap="onMode"
        >
          <view class="mode-head">
            <view class="mode-mark"></view>
            <view class="mode-title">分队报名</view>
          </view>
          <view class="mode-tag">原有报名方式</view>
          <view class="mode-desc">两队各报各的，默认各 11 人。本队满了可排后补，或改报对方队。</view>
        </view>
        <view
          class="mode-card {{signupMode === 'joint' ? 'active' : ''}}"
          data-mode="joint"
          bindtap="onMode"
        >
          <view class="mode-head">
            <view class="mode-mark"></view>
            <view class="mode-title">联合报名</view>
          </view>
          <view class="mode-tag">新的报名方式</view>
          <view class="mode-desc">共享报名资源池，分三队报名（本队、联队、对方），每组固定 8 人，人数不能改。</view>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="label">标题</text>
      <input class="input" value="{{title}}" bindinput="onTitle" />
    </view>
    <view class="field">
      <text class="label">地点</text>
      <input class="input" placeholder="球场" value="{{location}}" bindinput="onLocation" />
    </view>
    <view class="field">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="picker-value">{{date}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">时间</text>
      <picker mode="time" value="{{time}}" bindchange="onTime">
        <view class="picker-value">{{time}}</view>
      </picker>
    </view>
    <view class="field" wx:if="{{signupMode !== 'joint'}}" wx:for="{{teams}}" wx:key="_id">
      <text class="label">{{item.name}} 人数</text>
      <picker mode="selector" range="{{counts}}" value="{{quotas[item._id] - 1}}" data-team="{{item._id}}" bindchange="onQuota">
        <view class="picker-value">{{quotas[item._id]}} 人</view>
      </picker>
    </view>
    <view class="muted" wx:if="{{signupMode === 'joint'}}">共享资源池分三队报名，每组固定 8 人，下方不用再选人数。</view>
    <button class="btn" loading="{{saving}}" bindtap="submit">创建</button>
  </view>
  <mirror />
</view>
