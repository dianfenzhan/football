<view class="page" wx:if="{{activity}}">
  <view wx:if="{{!closed}}" class="top-stick">
    <block wx:if="{{!me}}">
      <view class="top-actions">
        <button class="btn hero" bindtap="openRegister">⚽️ 立即报名</button>
      </view>
      <view class="muted top-note">点上方按钮，一键微信注册即报名</view>
    </block>
    <block wx:else>
      <view wx:if="{{myPigeon}}" class="signed-banner">
        <text class="signed-text">已取消，记了一次鸽子</text>
      </view>
      <view wx:if="{{!signed && !waiting}}" class="top-actions">
        <button class="btn hero" bindtap="signup">{{signupButtonText}}</button>
      </view>
      <block wx:elif="{{waiting}}">
        <view class="signed-banner">
          <text class="signed-text">{{waitBanner}}</text>
          <view class="banner-actions">
            <view class="banner-btn" hover-class="banner-btn-hover" hover-stay-time="80" bindtap="changeWait">修改补位时间</view>
            <view class="banner-btn danger" hover-class="banner-btn-hover" hover-stay-time="80" bindtap="cancel">取消后补</view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="signed-banner">
          <view class="signed-body">
            <text class="signed-text">✓ 已报名 · {{signedTeamName}}</text>
            <view wx:if="{{placeNote}}" class="signed-note">{{placeNote}}</view>
          </view>
          <view class="banner-actions single">
            <view class="banner-btn danger" hover-class="banner-btn-hover" hover-stay-time="80" bindtap="cancel">取消报名</view>
          </view>
        </view>
      </block>
      <view class="top-actions">
        <button class="btn ghost hero-ghost" open-type="share">📤 邀请队友</button>
      </view>
    </block>
  </view>
  <view wx:if="{{closed}}" class="muted top-note">活动已开始，报名已截止。</view>

  <view class="card">
    <view class="title">{{activity.title}}</view>
    <view class="muted">{{activity.timeText}}</view>
    <view class="muted">{{activity.location}}</view>
  </view>

  <view class="card">
    <view class="title">报名名单</view>
    <view wx:if="{{joint}}" class="muted roster-tip">
      <block wx:if="{{draggingId}}">{{dragHint}}</block>
      <block wx:elif="{{me && me.isAdmin}}">
        <view>对调：拖到队员身上</view>
        <view>换队：拖到空白处</view>
      </block>
      <block wx:else>
        <view>换队：长按自己拖到有空的队</view>
        <view>对调：请找管理员</view>
      </block>
    </view>
    <view
      class="roster {{joint ? 'joint' : 'split'}} {{draggingId ? 'is-dragging' : ''}}"
      bindtouchmove="onRosterTouchMove"
      catchtouchmove="{{draggingId ? 'onRosterTouchMove' : ''}}"
      bindtouchend="onRosterTouchEnd"
      bindtouchcancel="onRosterTouchEnd"
    >
      <view class="roster-col {{item.teamId === 'team_unite' ? 'unite' : ''}} {{draggingId ? 'drop-target' : ''}} {{draggingId && !dragHoverOpenid && dragHoverTeam === item.teamId ? 'drop-hover' : ''}} {{draggingId && item.full ? 'drop-full' : ''}}" wx:for="{{roster}}" wx:key="teamId" data-team="{{item.teamId}}" bindtap="onDropTeam">
        <view class="roster-head">{{item.teamName}}</view>
        <view class="muted quota-line" wx:if="{{joint}}">
          {{item.signed}}/{{item.maxSignups}}{{item.full ? ' 满' : ''}}
        </view>
        <view class="muted quota-line" wx:else>
          已报 {{item.signed}} /
          <picker wx:if="{{me && me.isAdmin && !closed && !quotaLocked}}" mode="selector" range="{{counts}}" value="{{item.countIndex}}" data-team="{{item.teamId}}" bindchange="onQuota">
            <text class="quota-num">{{item.maxSignups}}</text>
          </picker>
          <text wx:else>{{item.maxSignups}}</text>
          {{item.full ? ' · 已满' : ''}}
        </view>
        <view wx:if="{{item.players.length === 0}}" class="muted roster-empty">{{joint ? '空' : '还没有人'}}</view>
        <view
          wx:for="{{item.players}}"
          wx:for-item="player"
          wx:key="_openid"
          class="player {{draggingId === player._openid ? 'is-source' : ''}} {{dragHoverOpenid === player._openid ? 'drop-hover-player' : ''}}"
          data-openid="{{player._openid}}"
          data-team="{{item.teamId}}"
          data-name="{{player.shortName}}"
          bindlongpress="onDragStart"
          bindtap="onMovePlayer"
        >
          <image wx:if="{{player.avatarUrl}}" class="avatar avatar-sm" src="{{player.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-fallback avatar-sm" style="background: {{player.avatarBg}};">{{player.avatarChar}}</view>
          <text class="player-name {{draggingId === player._openid ? 'dragging' : ''}}">{{player.shortName}}</text>
        </view>
        <view class="col-wait-spacer" wx:if="{{!joint}}"></view>
        <view class="col-wait" wx:if="{{!joint}}">
          <view class="col-wait-head">
            <text class="col-wait-label">后补</text>
            <text class="col-wait-count">{{item.waiters.length}}/3</text>
          </view>
          <view wx:if="{{!item.waiters.length}}" class="col-wait-empty">暂无</view>
          <view
            wx:for="{{item.waiters}}"
            wx:for-item="player"
            wx:key="_openid"
            class="wait-row {{me && me._openid === player._openid ? 'mine' : ''}}"
          >
            <text class="wait-rank">{{player.order}}</text>
            <image wx:if="{{player.avatarUrl}}" class="wait-avatar" src="{{player.avatarUrl}}" mode="aspectFill"/>
            <view wx:else class="wait-fallback" style="background: {{player.avatarBg}};">{{player.avatarChar}}</view>
            <text class="wait-name">{{player.shortName}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="joint-wait" wx:if="{{joint}}">
      <view class="col-wait-head">
        <text class="col-wait-label">后补</text>
        <text class="col-wait-count">{{waitlist.length}}/6</text>
      </view>
      <view wx:if="{{!waitlist.length}}" class="joint-wait-empty">暂无后补</view>
      <view wx:else class="joint-wait-list">
        <view
          wx:for="{{waitlist}}"
          wx:key="_openid"
          class="wait-row {{me && me._openid === item._openid ? 'mine' : ''}}"
        >
          <text class="wait-rank">{{item.order}}</text>
          <image wx:if="{{item.avatarUrl}}" class="wait-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="wait-fallback" style="background: {{item.avatarBg}};">{{item.avatarChar}}</view>
          <text class="wait-name">{{item.shortName}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{pigeons.length}}" class="pigeon-block">
      <view class="pigeon-title">🐦 本场鸽子</view>
      <view wx:for="{{pigeons}}" wx:key="playerOpenid" class="pigeon-line">{{item.userName}}</view>
    </view>
  </view>

  <view
    id="tactics-card"
    class="card tactics-card"
    catchtouchmove="{{tacticsDragPreviewActive ? 'onTacticsTouchMove' : ''}}"
  >
    <view class="tactics-head">
      <view class="title">战术板 · {{tacticsTeamName || '本队'}}</view>
      <view class="tactics-badge">8人</view>
    </view>
    <view class="reg-teams tactics-team-tabs">
      <view
        wx:for="{{tacticsList}}"
        wx:key="teamId"
        class="reg-team {{tacticsTeamId === item.teamId ? 'active' : ''}}"
        data-teamid="{{item.teamId}}"
        bindtap="switchTacticsTeam"
      >{{item.teamName}}</view>
    </view>
    <view class="muted tactics-tip">{{canEditTactics ? '正选出勤前 8 上场，其余在轮换；拖到轮换区下场。本场正选可改任意队' : '正选出勤前 8 上场，其余在轮换；仅本场正选可改阵容'}}</view>
    <view wx:if="{{tacticsRemovedNotice}}" class="tactics-notice">{{tacticsRemovedNotice}}</view>

    <view id="tacticsPitch" class="tactics-pitch">
      <view class="pitch-line-box">
        <view class="pitch-box-top"></view>
        <view class="pitch-midline"></view>
        <view class="pitch-circle"></view>
        <view class="pitch-box-bottom"></view>
      </view>

      <view
        wx:for="{{tacticsBoard.emptySlots}}"
        wx:key="index"
        class="pitch-free-slot is-empty"
        style="left: {{item.x * 100}}%; top: {{item.y * 100}}%;"
      >
        <view class="pitch-avatar-wrap">
          <view class="pitch-avatar pitch-avatar-empty">{{item.role === 'gk' ? item.shortLabel : ''}}</view>
        </view>
        <view class="pitch-name empty">{{item.emptyText}}</view>
      </view>

      <view
        wx:for="{{tacticsBoard.onPitch}}"
        wx:key="userId"
        class="pitch-free-slot {{tacticsDraggingUserId === item.userId ? 'dragging' : ''}} {{item.role === 'gk' ? 'is-gk' : ''}}"
        style="left: {{item.leftPct}}%; top: {{item.topPct}}%;"
        data-userid="{{item.userId}}"
        data-source="pitch"
        bindtouchstart="onTacticsTouchStart"
        catchtouchmove="onTacticsTouchMove"
        bindtouchend="onTacticsTouchEnd"
        bindtouchcancel="onTacticsTouchEnd"
      >
        <view class="pitch-avatar-wrap">
          <image wx:if="{{item.avatarUrl}}" class="pitch-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="pitch-avatar pitch-avatar-fallback" style="background: {{item.avatarBg}};">{{item.avatarChar}}</view>
          <view wx:if="{{item.role === 'gk'}}" class="pitch-role gk-role">{{item.shortLabel}}</view>
        </view>
        <view class="pitch-name">{{item.userName}}</view>
      </view>

      <view
        wx:if="{{tacticsDragPreviewActive && tacticsDragPlayer}}"
        class="pitch-free-slot drag-ghost"
        style="left: {{tacticsDragPreviewLeft}}%; top: {{tacticsDragPreviewTop}}%;"
      >
        <view class="pitch-avatar-wrap">
          <image wx:if="{{tacticsDragPlayer.avatarUrl}}" class="pitch-avatar" src="{{tacticsDragPlayer.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="pitch-avatar pitch-avatar-fallback" style="background: {{tacticsDragPlayer.avatarBg}};">{{tacticsDragPlayer.avatarChar}}</view>
        </view>
        <view class="pitch-name">{{tacticsDragPlayer.userName}}</view>
      </view>
    </view>

    <view id="tacticsBench" class="tactics-bench {{tacticsDragPreviewActive ? 'drop-target' : ''}}">
      <view class="bench-head">
        <view class="bench-title">轮换（{{tacticsBoard.bench.length}}人）</view>
      </view>
      <view wx:if="{{!tacticsBoard.bench.length}}" class="bench-empty-drop">拖到这里下场 / 暂无轮换球员</view>
      <view wx:else class="bench-list">
        <view
          wx:for="{{tacticsBoard.bench}}"
          wx:key="userId"
          class="bench-chip {{tacticsDraggingUserId === item.userId ? 'selected' : ''}}"
          data-userid="{{item.userId}}"
          data-source="bench"
          bindtouchstart="onTacticsTouchStart"
          catchtouchmove="onTacticsTouchMove"
          bindtouchend="onTacticsTouchEnd"
          bindtouchcancel="onTacticsTouchEnd"
        >
          <image wx:if="{{item.avatarUrl}}" class="bench-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="bench-avatar bench-avatar-fallback" style="background: {{item.avatarBg}};">{{item.avatarChar}}</view>
          <view class="bench-name">{{item.userName}}</view>
          <view class="bench-pos">{{item.positionLabel}}</view>
        </view>
      </view>
    </view>

    <button
      class="btn save-lineup-btn"
      loading="{{savingTacticsBoard}}"
      disabled="{{!canEditTactics || savingTacticsBoard}}"
      bindtap="saveActivityTacticsBoard"
    >{{canEditTactics ? '保存阵容' : '仅正选可保存'}}</button>

    <view class="tactics-actions">
      <button class="btn ghost tactics-btn" loading="{{exportingTactics}}" disabled="{{exportingTactics}}" bindtap="saveTacticsPoster">💾 保存到相册</button>
      <button class="btn ghost tactics-btn" loading="{{exportingTactics}}" disabled="{{exportingTactics}}" bindtap="shareTacticsPoster">📤 分享战术图</button>
    </view>
  </view>

  <canvas type="2d" id="tacticsCanvas" class="tactics-canvas"></canvas>

  <view wx:if="{{me && me.isAdmin && closed}}" class="card">
    <view class="title">记录数据</view>
    <view wx:if="{{signedMembers.length === 0}}" class="muted">这场还没有人报名。</view>
    <block wx:else>
      <view class="reg-teams member-filter">
        <view
          wx:for="{{memberFilters}}"
          wx:key="id"
          class="reg-team {{memberTeam === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onMemberTeam"
        >{{item.name}}</view>
      </view>
      <view wx:if="{{pickMembers.length === 0}}" class="muted">这个队这场还没有人报名。</view>
      <view wx:else class="field">
        <text class="label">队员</text>
        <picker mode="selector" range="{{pickMembers}}" range-key="label" value="{{pickIndex}}" bindchange="onPickPlayer">
          <view class="picker-value">{{pickedLabel}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">⚽️ 进球</text>
        <picker mode="selector" range="{{statOptions}}" value="{{goalIndex}}" bindchange="onEditGoals">
          <view class="picker-value">{{statOptions[goalIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">👟 助攻</text>
        <picker mode="selector" range="{{statOptions}}" value="{{assistIndex}}" bindchange="onEditAssists">
          <view class="picker-value">{{statOptions[assistIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">出勤情况</text>
        <picker mode="selector" range="{{pigeonOptions}}" value="{{pigeonIndex}}" bindchange="onEditAbsent">
          <view class="picker-value">{{pigeonOptions[pigeonIndex]}}</view>
        </picker>
      </view>
      <button class="btn" loading="{{savingStat}}" bindtap="saveStat">保存</button>
    </block>
  </view>

  <view class="card" wx:if="{{closed}}">
    <view class="title">本场数据</view>
    <view wx:if="{{records.length === 0}}" class="muted">还没有记录</view>
    <view class="swipe" wx:for="{{records}}" wx:key="playerOpenid">
      <view wx:if="{{me && me.isAdmin && item.editable}}" class="swipe-delete" data-id="{{item._id}}" data-name="{{item.userName}}" catchtap="askDeleteRecord">删除</view>
      <view
        class="swipe-row {{item.dragging ? 'dragging' : ''}}"
        style="{{item.offset ? 'transform: translateX(' + item.offset + 'px);' : ''}}"
        data-list="records"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
      >
        <view class="record-who">
          <image wx:if="{{item.avatarUrl}}" class="avatar avatar-sm" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-fallback avatar-sm" style="background: {{item.avatarBg}};">{{item.avatarChar}}</view>
          <text>{{item.userName}} · {{item.teamName}}</text>
        </view>
        <view wx:if="{{me && me.isAdmin && item.editable}}" class="stat-line">
          <picker mode="selector" range="{{statOptions}}" value="{{item.goalIndex}}" data-openid="{{item.playerOpenid}}" bindchange="onRowGoals">
            <text>⚽️ <text class="quota-num">{{item.goals}}</text></text>
          </picker>
          <picker mode="selector" range="{{statOptions}}" value="{{item.assistIndex}}" data-openid="{{item.playerOpenid}}" bindchange="onRowAssists">
            <text>👟 <text class="quota-num">{{item.assists}}</text></text>
          </picker>
          <picker mode="selector" range="{{pigeonOptions}}" value="{{item.pigeonIndex}}" data-openid="{{item.playerOpenid}}" bindchange="onRowAbsent">
            <text class="quota-num">{{item.absent ? '🐦' : '正常'}}</text>
          </picker>
        </view>
        <view wx:else class="muted">⚽️ {{item.goals}} · 👟 {{item.assists}} · {{item.absent ? '🐦' : '正常'}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{closed}}">
    <view class="title">每轮比分</view>
    <view class="muted">{{roundVsText}}</view>
    <view class="swipe" wx:for="{{rounds}}" wx:key="_id">
      <view wx:if="{{me && me.isAdmin}}" class="swipe-delete" data-id="{{item._id}}" data-no="{{item.roundNo}}" catchtap="askDeleteRound">删除</view>
      <view
        class="swipe-row {{item.dragging ? 'dragging' : ''}}"
        style="{{item.offset ? 'transform: translateX(' + item.offset + 'px);' : ''}}"
        data-list="rounds"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
      >
        <view>第 {{item.roundNo}} 轮　{{item.scoreLeft}} : {{item.scoreRight}}</view>
      </view>
    </view>
    <view wx:if="{{me && me.isAdmin}}">
      <view class="row score-row">
        <picker mode="selector" range="{{statOptions}}" value="{{scoreLeft}}" bindchange="onScoreLeft">
          <view class="picker-value score">{{statOptions[scoreLeft]}}</view>
        </picker>
        <text>:</text>
        <picker mode="selector" range="{{statOptions}}" value="{{scoreRight}}" bindchange="onScoreRight">
          <view class="picker-value score">{{statOptions[scoreRight]}}</view>
        </picker>
      </view>
      <button class="btn" bindtap="addRound">加一轮</button>
    </view>
  </view>

  <view wx:if="{{showRegister}}" class="share-mask" catchtouchmove="noop">
    <view class="share-sheet">
      <view class="title">一键注册并报名</view>
      <view class="reg-avatar-row">
        <button class="avatar-chooser" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{regAvatarUrl}}" class="avatar-img" src="{{regAvatarUrl}}" mode="aspectFill"/>
          <text wx:else class="avatar-plus">+</text>
        </button>
        <view class="muted">点头像，选微信头像</view>
      </view>
      <input type="nickname" class="input reg-input" placeholder="点这里快捷填入微信昵称" value="{{regName}}" bindinput="onRegName"/>
      <view class="reg-teams">
        <view
          wx:for="{{teams}}"
          wx:key="_id"
          class="reg-team {{regTeamId === item._id ? 'active' : ''}}"
          data-team="{{item._id}}"
          bindtap="onRegTeam"
        >{{item.name}}</view>
      </view>
      <button class="btn" loading="{{regSaving}}" disabled="{{regSaving}}" bindtap="submitRegister">保存并报名</button>
      <button class="btn ghost" bindtap="closeRegister">取消</button>
    </view>
  </view>

  <view wx:if="{{showSplitChoice}}" class="share-mask" catchtouchmove="noop">
    <view class="split-choice">
      <view class="split-choice-title">本队正选已满</view>
      <view class="split-choice-actions">
        <button class="split-choice-btn primary" data-choice="waitlist" bindtap="chooseSplit">后补本队</button>
        <button class="split-choice-btn" data-choice="other" bindtap="chooseSplit">改报对面</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showWaitHours}}" class="share-mask" catchtouchmove="noop">
    <view class="share-sheet">
      <view class="title">后补守到什么时候</view>
      <scroll-view class="wait-hour-list" scroll-y scroll-into-view="{{waitHourInto}}">
        <view
          wx:for="{{waitHourOptions}}"
          wx:key="hours"
          id="wait-hour-{{item.hours}}"
          class="wait-hour-item {{waitHourSelected === item.hours ? 'on' : ''}}"
          data-hours="{{item.hours}}"
          bindtap="onSelectWaitHour"
        >{{item.label}}</view>
      </scroll-view>
      <button class="btn" bindtap="confirmWaitHour">确定</button>
      <button class="btn ghost" bindtap="closeWaitHours">取消</button>
    </view>
  </view>

  <view wx:if="{{showPledge}}" class="share-mask" catchtouchmove="noop">
    <view class="share-sheet">
      <view class="title">{{pledgeTitle}}</view>
      <view class="pledge-rule" wx:if="{{pledgeKind !== 'wait'}}">{{pigeonRuleText}}</view>
      <view class="pledge-lines" wx:if="{{pledgeLines.length}}">
        <view class="pledge-line" wx:for="{{pledgeLines}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="muted" wx:elif="{{pledgeHint}}">{{pledgeHint}}</view>
      <button class="btn pledge-go" bindtap="confirmPledge">{{pledgeButtonText}}</button>
      <button class="btn ghost" bindtap="dismissPledge">{{pledgeKind === 'wait' ? '先不排' : '先不报'}}</button>
    </view>
  </view>

  <nav current="activities" />
  <mirror />
</view>

<view wx:if="{{loadFailed}}" class="page">
  <view class="empty-state">
    <view class="empty-icon">🥅</view>
    <view class="empty-title">活动不存在或已取消</view>
    <view class="muted">链接可能已失效，找队友要个新链接吧</view>
  </view>
  <nav current="activities" />
  <mirror />
</view>
