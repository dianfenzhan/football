<view class="page" wx:if="{{activity}}">
  <view wx:if="{{!closed}}" class="top-stick">
    <block wx:if="{{!me}}">
      <view class="top-actions">
        <button class="btn hero" bindtap="openRegister">⚽️ 立即报名</button>
      </view>
      <view class="muted top-note">点上方按钮，一键微信注册即报名</view>
    </block>
    <block wx:else>
      <view wx:if="{{!signed}}" class="top-actions">
        <button class="btn hero" bindtap="signup">{{signupButtonText}}</button>
      </view>
      <block wx:else>
        <view class="signed-banner">
          <text class="signed-text">✓ 已报名 · {{signedTeamName}}</text>
          <view class="signed-cancel" hover-class="signed-cancel-hover" hover-stay-time="80" bindtap="cancel">取消报名</view>
        </view>
      </block>
      <view class="top-actions">
        <button class="btn ghost hero-ghost" open-type="share">📤 邀请队友</button>
      </view>
    </block>
  </view>
  <view wx:if="{{closed}}" class="muted top-note">活动已开始，报名已截止。</view>

  <view class="card">
    <view class="title">{{activity.title}}</view>
    <view class="muted">{{activity.timeText}}</view>
    <view class="muted">{{activity.location}}</view>
  </view>

  <view class="card">
    <view class="title">报名名单</view>
    <view class="roster">
      <view class="roster-col" wx:for="{{roster}}" wx:key="teamId">
        <view class="roster-head">{{item.teamName}}</view>
        <view class="muted quota-line">
          已报 {{item.signed}} /
          <picker wx:if="{{me && me.isAdmin && !closed}}" mode="selector" range="{{counts}}" value="{{item.countIndex}}" data-team="{{item.teamId}}" bindchange="onQuota">
            <text class="quota-num">{{item.maxSignups}}</text>
          </picker>
          <text wx:else>{{item.maxSignups}}</text>
          {{item.full ? ' · 已满' : ''}}
        </view>
        <view wx:if="{{item.players.length === 0}}" class="muted roster-empty">还没有人</view>
        <view wx:for="{{item.players}}" wx:for-item="player" wx:key="_openid" class="player">
          <image wx:if="{{player.avatarUrl}}" class="avatar avatar-sm" src="{{player.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-fallback avatar-sm" style="background: {{player.avatarBg}};">{{player.avatarChar}}</view>
          <text class="player-name">{{player.userName}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{me && me.isAdmin && closed}}" class="card">
    <view class="title">记录数据</view>
    <view wx:if="{{signedMembers.length === 0}}" class="muted">这场还没有人报名。</view>
    <block wx:else>
      <view class="reg-teams member-filter">
        <view
          wx:for="{{memberFilters}}"
          wx:key="id"
          class="reg-team {{memberTeam === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onMemberTeam"
        >{{item.name}}</view>
      </view>
      <view wx:if="{{pickMembers.length === 0}}" class="muted">这个队这场还没有人报名。</view>
      <view wx:else class="field">
        <text class="label">队员</text>
        <picker mode="selector" range="{{pickMembers}}" range-key="label" value="{{pickIndex}}" bindchange="onPickPlayer">
          <view class="picker-value">{{pickedLabel}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">⚽️ 进球</text>
        <picker mode="selector" range="{{statOptions}}" value="{{goalIndex}}" bindchange="onEditGoals">
          <view class="picker-value">{{statOptions[goalIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">👟 助攻</text>
        <picker mode="selector" range="{{statOptions}}" value="{{assistIndex}}" bindchange="onEditAssists">
          <view class="picker-value">{{statOptions[assistIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">出勤情况</text>
        <picker mode="selector" range="{{pigeonOptions}}" value="{{pigeonIndex}}" bindchange="onEditAbsent">
          <view class="picker-value">{{pigeonOptions[pigeonIndex]}}</view>
        </picker>
      </view>
      <button class="btn" loading="{{savingStat}}" bindtap="saveStat">保存</button>
    </block>
  </view>

  <view class="card" wx:if="{{closed}}">
    <view class="title">本场数据</view>
    <view wx:if="{{records.length === 0}}" class="muted">还没有记录</view>
    <view class="swipe" wx:for="{{records}}" wx:key="playerOpenid">
      <view wx:if="{{me && me.isAdmin}}" class="swipe-delete" data-id="{{item._id}}" data-name="{{item.userName}}" catchtap="askDeleteRecord">删除</view>
      <view
        class="swipe-row {{item.dragging ? 'dragging' : ''}}"
        style="{{item.offset ? 'transform: translateX(' + item.offset + 'px);' : ''}}"
        data-list="records"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
      >
        <view class="record-who">
          <image wx:if="{{item.avatarUrl}}" class="avatar avatar-sm" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-fallback avatar-sm" style="background: {{item.avatarBg}};">{{item.avatarChar}}</view>
          <text>{{item.userName}} · {{item.teamName}}</text>
        </view>
        <view wx:if="{{me && me.isAdmin}}" class="stat-line">
          <picker mode="selector" range="{{statOptions}}" value="{{item.goalIndex}}" data-openid="{{item.playerOpenid}}" bindchange="onRowGoals">
            <text>⚽️ <text class="quota-num">{{item.goals}}</text></text>
          </picker>
          <picker mode="selector" range="{{statOptions}}" value="{{item.assistIndex}}" data-openid="{{item.playerOpenid}}" bindchange="onRowAssists">
            <text>👟 <text class="quota-num">{{item.assists}}</text></text>
          </picker>
          <picker mode="selector" range="{{pigeonOptions}}" value="{{item.pigeonIndex}}" data-openid="{{item.playerOpenid}}" bindchange="onRowAbsent">
            <text class="quota-num">{{item.absent ? '🐦' : '正常'}}</text>
          </picker>
        </view>
        <view wx:else class="muted">⚽️ {{item.goals}} · 👟 {{item.assists}} · {{item.absent ? '🐦' : '正常'}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{closed}}">
    <view class="title">每轮比分</view>
    <view class="muted">jiong 路青少年 vs 浦东老聚三</view>
    <view class="swipe" wx:for="{{rounds}}" wx:key="_id">
      <view wx:if="{{me && me.isAdmin}}" class="swipe-delete" data-id="{{item._id}}" data-no="{{item.roundNo}}" catchtap="askDeleteRound">删除</view>
      <view
        class="swipe-row {{item.dragging ? 'dragging' : ''}}"
        style="{{item.offset ? 'transform: translateX(' + item.offset + 'px);' : ''}}"
        data-list="rounds"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
      >
        <view>第 {{item.roundNo}} 轮　{{item.scoreJiong}} : {{item.scorePudong}}</view>
      </view>
    </view>
    <view wx:if="{{me && me.isAdmin}}">
      <view class="row score-row">
        <picker mode="selector" range="{{statOptions}}" value="{{scoreJiong}}" bindchange="onScoreJiong">
          <view class="picker-value score">{{statOptions[scoreJiong]}}</view>
        </picker>
        <text>:</text>
        <picker mode="selector" range="{{statOptions}}" value="{{scorePudong}}" bindchange="onScorePudong">
          <view class="picker-value score">{{statOptions[scorePudong]}}</view>
        </picker>
      </view>
      <button class="btn" bindtap="addRound">加一轮</button>
    </view>
  </view>

  <view wx:if="{{showRegister}}" class="share-mask" catchtouchmove="noop">
    <view class="share-sheet">
      <view class="title">一键注册并报名</view>
      <view class="reg-avatar-row">
        <button class="avatar-chooser" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{regAvatarUrl}}" class="avatar-img" src="{{regAvatarUrl}}" mode="aspectFill"/>
          <text wx:else class="avatar-plus">+</text>
        </button>
        <view class="muted">点头像，选微信头像</view>
      </view>
      <input type="nickname" class="input reg-input" placeholder="点这里快捷填入微信昵称" value="{{regName}}" bindinput="onRegName"/>
      <view class="reg-teams">
        <view
          wx:for="{{teams}}"
          wx:key="_id"
          class="reg-team {{regTeamId === item._id ? 'active' : ''}}"
          data-team="{{item._id}}"
          bindtap="onRegTeam"
        >{{item.name}}</view>
      </view>
      <button class="btn" loading="{{regSaving}}" disabled="{{regSaving}}" bindtap="submitRegister">保存并报名</button>
      <button class="btn ghost" bindtap="closeRegister">取消</button>
    </view>
  </view>

  <view wx:if="{{showSharePrompt}}" class="share-mask" catchtouchmove="noop">
    <view class="share-sheet">
      <view class="title">活动已创建</view>
      <view class="muted">发给群或好友，对方点开就能报名。可以连续发几次。</view>
      <button class="btn" open-type="share">分享</button>
      <button class="btn ghost" bindtap="closeSharePrompt">稍后</button>
    </view>
  </view>

  <nav current="activities" />
</view>

<view wx:if="{{loadFailed}}" class="page">
  <view class="empty-state">
    <view class="empty-icon">🥅</view>
    <view class="empty-title">活动不存在或已取消</view>
    <view class="muted">链接可能已失效，找队友要个新链接吧</view>
  </view>
  <nav current="activities" />
</view>
