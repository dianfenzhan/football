.top-stick {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f4f6f5;
  padding-top: 4rpx;
}

.top-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.top-action {
  flex: 1;
  min-width: 0;
}

.top-action .btn {
  width: 100%;
  margin: 0;
  padding: 0 12rpx;
}

.btn.hero {
  width: 100%;
  margin: 0;
  line-height: 2.8;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

.btn.hero-ghost {
  width: 100%;
  margin: 0;
  line-height: 2.4;
  border-radius: 16rpx;
}

.signed-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #e3efe9;
  color: #0f3d2e;
  border-radius: 16rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  margin-bottom: 20rpx;
}

.signed-text {
  flex: 1;
  min-width: 0;
  font-weight: 600;
}

.signed-cancel {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #0f3d2e;
  font-size: 26rpx;
  font-weight: 600;
}

.signed-cancel-hover {
  background: #d5e5dd;
}

.reg-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0;
}

.avatar-chooser {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #e7eeeb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.avatar-plus {
  font-size: 48rpx;
  color: #66706c;
  line-height: 1;
}

.reg-input {
  margin-bottom: 20rpx;
}

.reg-teams {
  display: flex;
  gap: 16rpx;
}

.member-filter {
  margin-bottom: 20rpx;
}

.reg-team {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #3d4944;
}

.reg-team.active {
  background: #0f3d2e;
  color: #fff;
  font-weight: 600;
}

.top-note {
  margin: 12rpx 4rpx 0;
}

.quota-line {
  display: flex;
  align-items: center;
}

.quota-num {
  color: #0f3d2e;
  font-weight: 700;
  padding: 0 8rpx;
}

.stat-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.roster {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 16rpx;
}

.roster-col {
  flex: 1;
  min-width: 0;
}

.roster-head {
  font-weight: 600;
  line-height: 1.3;
}

.roster-empty {
  padding-top: 12rpx;
}

.swipe {
  position: relative;
  overflow: hidden;
  border-top: 1rpx solid #eef2f0;
}

.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #8c3a2f;
  color: #fff;
  font-size: 28rpx;
}

.swipe-row {
  position: relative;
  z-index: 1;
  padding: 16rpx 0;
  background: #fff;
  transition: transform 0.15s ease;
}

.swipe-row.dragging {
  transition: none;
}

.roster-col .player {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  word-break: break-all;
}

.player-name {
  min-width: 0;
}

.record-who {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.absent {
  color: #8c3a2f;
}

.stat-edit {
  margin-top: 16rpx;
}

.score-row {
  margin-top: 12rpx;
}

.score {
  width: 120rpx;
  text-align: center;
}

.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(28, 36, 33, 0.45);
}

.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.share-sheet .title {
  margin-bottom: 8rpx;
}

.share-sheet .btn {
  display: block;
  width: 100%;
  margin: 24rpx 0 0;
}

.empty-state {
  text-align: center;
  padding: 160rpx 48rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

button {
  margin: 8rpx 8rpx 0 0;
}
