<view class="page">
  <view wx:if="{{loading}}" class="muted">加载中</view>
  <view wx:elif="{{activities.length === 0}}" class="card muted">还没有活动。管理员可以新建一场，再把页面转发到两个群。</view>
  <view class="swipe" wx:for="{{activities}}" wx:key="_id">
    <view wx:if="{{isAdmin}}" class="swipe-delete" data-id="{{item._id}}" catchtap="askDelete">删除</view>
    <view
      class="card swipe-card {{item.dragging ? 'dragging' : ''}}"
      style="{{item.offset ? 'transform: translateX(' + item.offset + 'px);' : ''}}"
      data-id="{{item._id}}"
      data-index="{{index}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtap="open"
    >
      <view class="title">{{item.title}}</view>
      <view class="muted">{{item.timeText}} · {{item.location}}</view>
      <view class="muted">{{item.quotaText}}</view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="muted">加载中</view>
  <view wx:elif="{{!hasMore && activities.length > 0}}" class="muted">没有更多了</view>
  <view wx:if="{{isAdmin}}" class="fab" bindtap="create">＋</view>
  <nav current="activities" />
</view>
