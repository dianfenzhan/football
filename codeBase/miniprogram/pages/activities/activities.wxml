<view class="page">
  <club-nav title="活动" bind:change="onFilterChange" />
  <view wx:if="{{loading}}" class="muted">加载中</view>
  <view wx:elif="{{activities.length === 0}}" class="card muted">还没有活动。{{isAdmin ? '点右下角 ＋ 新建一场，再转发到群。' : '等管理员安排一场，或让队友把活动链接发给你。'}}</view>
  <view class="swipe" wx:for="{{activities}}" wx:key="_id">
    <view wx:if="{{canDelete}}" class="swipe-delete" data-id="{{item._id}}" catchtap="askDelete">删除</view>
    <view
      class="card swipe-card {{item.expired ? 'expired' : ''}} {{item.dragging ? 'dragging' : ''}}"
      style="{{item.offset ? 'transform: translateX(' + item.offset + 'px);' : ''}}"
      data-id="{{item._id}}"
      data-index="{{index}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtap="open"
    >
      <view class="title">{{item.title}}<text wx:if="{{item.clubLabel}}" class="club-tag"> · {{item.clubLabel}}</text></view>
      <view class="muted">{{item.timeText}} · {{item.location}}</view>
      <view class="muted">{{item.quotaText}}</view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="muted">加载中</view>
  <view wx:elif="{{!hasMore && activities.length > 0}}" class="muted">没有更多了</view>
  <view wx:if="{{isAdmin}}" class="fab" bindtap="create">＋</view>
  <nav current="activities" />
</view>
